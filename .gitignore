# Allowlist: only the kit itself is tracked.
# Client folders (ClientName/) stay local — they never reach this repo.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/NBG-logo.png
!/skills-lock.json
!/_template/
!/qa/
!/.claude/
!/Example/
!/Example-Studio/

node_modules/
# studio projects: scratch output and generated tokens (rebuilt by shared/build.sh)
exports/
Design-System/tokens.*
QA_screenshots/
.DS_Store
*.log
.vercel/
.claude/settings.local.json
